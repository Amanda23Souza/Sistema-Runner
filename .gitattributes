# Normaliza line endings para LF em todos os arquivos de texto
* text=auto eol=lf

# Go
*.go text eol=lf

# Java
*.java text eol=lf
*.xml  text eol=lf

# Markdown e documentação
*.md   text eol=lf
*.txt  text eol=lf

# Scripts shell (LF obrigatório)
*.sh text eol=lf

# Scripts Windows (CRLF obrigatório)
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# YAML / JSON
*.yml  text eol=lf
*.yaml text eol=lf
*.json text eol=lf

# Binários — não modificar
*.jar  binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.svg  binary
*.ico  binary
*.pdf  binary
*.zip  binary
*.tar  binary
*.gz   binary
